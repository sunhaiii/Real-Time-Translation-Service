{
  "name": "translation-system-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:open": "node scripts/open-browsers.js",
    "build": "next build",
    "build:win": "next build",
    "start": "npx --yes serve@14 out -l 3000",
    "launch:win": "node scripts/launch-windows-stack.js",
